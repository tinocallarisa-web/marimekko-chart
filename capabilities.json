{
  "dataRoles": [
    {
      "name": "category",
      "kind": "Grouping",
      "displayName": "Columns (segments)",
      "displayNameKey": "Role_category",
      "description": "The segments of the market: channel, region, category. Each column is as wide as its share of the total.",
      "descriptionKey": "Role_category_Desc"
    },
    {
      "name": "series",
      "kind": "Grouping",
      "displayName": "Series (stack)",
      "displayNameKey": "Role_series",
      "description": "Who shares each segment: company, brand, competitor. Free names 3 and sums the rest in Others; Pro up to 12.",
      "descriptionKey": "Role_series_Desc"
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value",
      "displayNameKey": "Role_value",
      "description": "Sales, volume or units. One measure.",
      "descriptionKey": "Role_value_Desc"
    },
    {
      "name": "comparison",
      "kind": "Measure",
      "displayName": "Comparison value (Pro)",
      "displayNameKey": "Role_comparison",
      "description": "The same measure for another period, for the change in share in percentage points.",
      "descriptionKey": "Role_comparison_Desc"
    },
    {
      "name": "panel",
      "kind": "Grouping",
      "displayName": "Small multiples (Pro)",
      "displayNameKey": "Role_panel",
      "description": "One chart per value, on a shared scale.",
      "descriptionKey": "Role_panel_Desc"
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips",
      "displayNameKey": "Role_tooltips",
      "description": "Extra values in the tooltip, up to 10.",
      "descriptionKey": "Role_tooltips_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "series": {
            "max": 1
          },
          "value": {
            "max": 1
          },
          "comparison": {
            "max": 1
          },
          "panel": {
            "max": 1
          },
          "tooltips": {
            "max": 10
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "category"
              }
            },
            {
              "bind": {
                "to": "series"
              }
            },
            {
              "bind": {
                "to": "panel"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "comparison"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
